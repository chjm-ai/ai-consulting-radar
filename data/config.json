{
  "ai": {
    "provider": "ali",
    "model": "qwen-plus",
    "api_key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2,
    "languages": [
      "zh"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-industry",
    "profile_settings": {
      "ai-industry": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "ai-vertical-apps": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "ai-coding-tools": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "overseas-plg": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
